  <property name="styleSheet">
   <string notr="true">
QWidget#QuickBluetoothWindow { background: transparent; }
#bluetoothBox {
    background-color: #18181b;
    border-radius: 20px;
    border: 1px solid #27272a;
}
#bluetoothBox QLabel { color: #fafafa; background: transparent; }
#titleLabel { font-size: 14px; font-weight: bold; }
#scrollArea, #scrollAreaWidgetContents { background: transparent; border: none; }
QScrollBar:vertical { background: transparent; width: 6px; }
QScrollBar::handle:vertical { background: #3f3f46; border-radius: 3px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
#settingsButton {
    background-color: transparent;
    color: #fafafa;
    border: none;
    border-radius: 12px;
    padding: 4px;
}
#settingsButton:hover { background-color: #27272a; }
#powerSwitch { spacing: 0; }
#powerSwitch::indicator { width: 40px; height: 22px; border-radius: 11px; background-color: #3f3f46; }
#powerSwitch::indicator:checked { background-color: #22c55e; }
#deviceActionButton {
    background-color: #3f3f46;
    color: #fafafa;
    border: none;
    border-radius: 8px;
    font-size: 12px;
    padding: 4px 10px;
}
#deviceActionButton:hover { background-color: #52525b; }
#deviceActionButton:disabled { color: #a1a1aa; }
   </string>
