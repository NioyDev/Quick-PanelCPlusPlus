  <property name="styleSheet">
   <string notr="true">
QLabel { color: #e4e4e7; background: transparent; }
#frameMain {
    background-color: #18181b;
    border: 1px solid #27272a;
    border-radius: 20px;
}
#labelTitle, #labelProfiles { font-size: 16px; font-weight: bold; color: #ffffff; }
#labelHealthValue, #labelPowerValue, #labelTempValue, #labelTimeValue {
    font-size: 14px; font-weight: bold; color: #e4e4e7;
}
#labelHealthCaption, #labelPowerCaption, #labelTempCaption, #labelTimeCaption,
#labelProfilesUnavailable { font-size: 11px; color: #a1a1aa; }

QProgressBar {
    min-height: 8px; max-height: 8px;
    border: none; border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.1);
}
QProgressBar::chunk {
    border-radius: 4px;
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #10b981, stop:1 #34d399);
}
QProgressBar[low="true"]::chunk { background-color: #ef4444; }

QPushButton {
    background-color: rgba(255, 255, 255, 0.05);
    color: #e4e4e7;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 8px;
    outline: none;
}
QPushButton:hover { background-color: rgba(255, 255, 255, 0.1); }
QPushButton:checked {
    background-color: rgba(59, 130, 246, 0.2);
    border: 1px solid #3b82f6;
}
   </string>
