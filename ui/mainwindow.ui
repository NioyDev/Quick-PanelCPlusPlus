								background-color: rgba(59, 130, 246, 0.30);
								border-color: #3b82f6;
								}
							</string>
						</property>
					</widget>
				</item>
				<item>
					<!-- Contenedor del cuerpo de la batería y su polo positivo -->
					<layout class="QHBoxLayout" name="layoutBatteryContainer">
						<property name="spacing">
							<number>2</number>
						</property>
						<item>
							<widget class="QPushButton" name="btnBattery">
								<property name="text">
									<string>--%</string>
								</property>
								<property name="cursor">
									<cursorShape>PointingHandCursor</cursorShape>
								</property>
								<property name="styleSheet">
									<string notr="true">
										QPushButton#btnBattery {
										background-color: rgba(16, 185, 129, 0.15);
										color: #18181b;
										font-weight: bold;
										font-size: 11px;
										border: 2px solid #27272a;
										border-top-left-radius: 4px;
										border-bottom-left-radius: 4px;
										border-top-right-radius: 2px;
										border-bottom-right-radius: 2px;
										padding: 1px 4px;
										min-width: 44px;
										max-width: 56px;
										max-height: 18px;
										}
										QPushButton#btnBattery:hover {
										background-color: rgba(16, 185, 129, 0.30);
										border-color: #10b981;
										}
									</string>
								</property>
							</widget>
						</item>
						<item>
							<!-- Borne/Polo positivo (+) -->
							<widget class="QFrame" name="frameBatteryTip">
								<property name="minimumSize">
									<size>
										<width>3</width>
										<height>8</height>
									</size>
								</property>
								<property name="maximumSize">
									<size>
										<width>3</width>
										<height>8</height>
									</size>
								</property>
								<property name="styleSheet">
									<string notr="true">
										QFrame#frameBatteryTip {
										background-color: #27272a;
										border-top-right-radius: 2px;
										border-bottom-right-radius: 2px;
										}
									</string>
								</property>
							</widget>
						</item>
					</layout>
				</item>
				<item>
					<!-- Botón de Reloj y Calendario -->
