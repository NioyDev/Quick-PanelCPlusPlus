<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
	<class>MainWindow</class>
	<widget class="QMainWindow" name="MainWindow">
		<property name="geometry">
			<rect>
				<x>0</x>
				<y>0</y>
				<width>800</width>
				<height>600</height>
			</rect>
		</property>
		<property name="windowTitle">
			<string>Quick Panel</string>
		</property>
		<widget class="QWidget" name="centralwidget">
			<layout class="QHBoxLayout" name="horizontalLayout">
				<!-- Ajuste de márgenes verticales para elevar los botones -->
				<property name="topMargin">
					<number>2</number>
				</property>
				<property name="bottomMargin">
					<number>8</number>
				</property>
				<!-- Margen derecho para dar lugar a las herramientas flotantes -->
				<property name="rightMargin">
					<number>16</number>
				</property>
				<item>
					<spacer name="horizontalSpacer">
						<property name="orientation">
							<enum>Qt::Horizontal</enum>
						</property>
					</spacer>
				</item>
				<item>
					<!-- Botón de Brillo -->
					<widget class="QPushButton" name="btnBrightness">
						<property name="text">
							<string>☀</string>
						</property>
						<property name="cursor">
							<cursorShape>PointingHandCursor</cursorShape>
						</property>
						<property name="styleSheet">
							<string notr="true">
								QPushButton#btnBrightness {
								background-color: rgba(251, 191, 36, 0.15);
								color: #18181b;
								font-weight: bold;
								font-size: 13px;
								border: 2px solid #27272a;
								border-radius: 4px;
								padding: 1px 4px;
								min-width: 28px;
								max-width: 36px;
								max-height: 18px;
								}
								QPushButton#btnBrightness:hover {
								background-color: rgba(251, 191, 36, 0.30);
								border-color: #f59e0b;
								}
							</string>
						</property>
					</widget>
				</item>
				<item>
					<!-- Botón de Bluetooth -->
					<widget class="QPushButton" name="btnBluetooth">
						<property name="text">
							<string>ᛒ</string>
						</property>
						<property name="cursor">
							<cursorShape>PointingHandCursor</cursorShape>
						</property>
						<property name="styleSheet">
							<string notr="true">
								QPushButton#btnBluetooth {
								background-color: rgba(59, 130, 246, 0.15);
								color: #18181b;
								font-weight: bold;
								font-size: 12px;
								border: 2px solid #27272a;
								border-radius: 4px;
								padding: 1px 4px;
								min-width: 28px;
								max-width: 36px;
								max-height: 18px;
								}
