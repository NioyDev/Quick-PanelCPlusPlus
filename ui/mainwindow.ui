<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
	<class>MainWindow</class>
	<widget class="QMainWindow" name="MainWindow">
		<property name="geometry">
			<rect>
				<x>0</x>
				<y>0</y>
				<width>800</width>
				<height>600</height>
			</rect>
		</property>
		<property name="windowTitle">
			<string>Quick Panel</string>
		</property>
		<widget class="QWidget" name="centralwidget">
			<layout class="QHBoxLayout" name="horizontalLayout">
				<!-- Reservamos 220px a la derecha para futuros widgets: Wi-Fi, Volumen y Reloj -->
				<property name="rightMargin">
					<number>220</number>
				</property>
				<item>
					<spacer name="horizontalSpacer">
						<property name="orientation">
							<enum>Qt::Horizontal</enum>
						</property>
					</spacer>
				</item>
				<item>
					<!-- Contenedor del cuerpo de la batería y su polo positivo -->
					<layout class="QHBoxLayout" name="layoutBatteryContainer">
						<property name="spacing">
							<number>2</number>
						</property>
						<item>
							<widget class="QPushButton" name="btnBattery">
								<property name="text">
									<string>--%</string>
								</property>
								<property name="cursor">
									<cursorShape>PointingHandCursor</cursorShape>
								</property>
								<property name="styleSheet">
									<string notr="true">
										QPushButton#btnBattery {
										background-color: rgba(16, 185, 129, 0.15);
										color: #18181b;
										font-weight: bold;
										font-size: 11px;
										border: 2px solid #27272a;
										border-top-left-radius: 4px;
										border-bottom-left-radius: 4px;
										border-top-right-radius: 2px;
										border-bottom-right-radius: 2px;
										padding: 1px 4px;
										min-width: 44px;
										max-width: 56px;
										max-height: 18px;
										}
										QPushButton#btnBattery:hover {
										background-color: rgba(16, 185, 129, 0.30);
										border-color: #10b981;
										}
									</string>
								</property>
							</widget>
						</item>
						<item>
							<!-- Borne/Polo positivo (+) -->
							<widget class="QFrame" name="frameBatteryTip">
								<property name="minimumSize">
									<size>
										<width>3</width>
										<height>8</height>
									</size>
								</property>
								<property name="maximumSize">
									<size>
										<width>3</width>
										<height>8</height>
									</size>
								</property>
								<property name="styleSheet">
									<string notr="true">
										QFrame#frameBatteryTip {
										background-color: #27272a;
										border-top-right-radius: 2px;
										border-bottom-right-radius: 2px;
										}
									</string>
								</property>
							</widget>
						</item>
					</layout>
				</item>
			</layout>
		</widget>
	</widget>
	<resources/>
	<connections/>
</ui>