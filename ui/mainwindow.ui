						<property name="cursor">
							<cursorShape>PointingHandCursor</cursorShape>
						</property>
						<property name="styleSheet">
							<string notr="true">
								QPushButton#btnClock {
								background-color: rgba(39, 39, 42, 0.08);
								color: #18181b;
								font-weight: bold;
								font-size: 10px;
								border: 2px solid #27272a;
								border-radius: 6px;
								padding: 1px 6px;
